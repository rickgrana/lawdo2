        <mxCell id="defaults" value="Padroes nao fixados no comando&#xa;&#xa;- Escala a zero / cold start&#xa;- Concorrencia por instancia&#xa;- CPU&#xa;&#xa;Ajustes opcionais: min-instances,&#xa;concurrency, cpu — latencia e picos" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="zone-cr">
