        <mxCell id="params" value="Parametros de deploy (gcloud run deploy)&#xa;&#xa;--region southamerica-east1&#xa;  Latencia / DR regional&#xa;&#xa;--memory 2Gi&#xa;  RAM para YOLO + OpenCV (menos OOM)&#xa;&#xa;--timeout=1000&#xa;  Teto por requisicao (s)&#xa;&#xa;--allow-unauthenticated&#xa;  Integracao simples / superficie publica&#xa;&#xa;--source .&#xa;  Build a partir do repo (exige best.pt no contexto)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="zone-cr">
          <mxGeometry x="40" y="60" width="380" height="280" as="geometry" />
        </mxCell>

        <mxCell id="docker" value="Container (Dockerfile)&#xa;&#xa;PORT (injeto pelo Cloud Run)&#xa;YOLO_CONFIG_DIR=/tmp/Ultralytics&#xa;uvicorn main:app" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="zone-cr">
          <mxGeometry x="40" y="380" width="380" height="120" as="geometry" />
